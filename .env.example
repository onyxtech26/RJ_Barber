# RJ Barber POS — environment (copy to .env.local; everything is optional on the shop PC)

# Database. Default: the local SQLite file data/rj-pos.db
# DATABASE_URL="file:data/rj-pos.db"

# Hosted demo on Vercel: a Turso database. Vercel's Turso integration sets these two for you.
# TURSO_DATABASE_URL="libsql://<db>-<org>.turso.io"
# TURSO_AUTH_TOKEN=""

# Initial PINs used by `npm run db:seed` (4–6 digits). Required for a hosted database.
# On the shop PC, if unset, random PINs are generated and written to data/initial-pins.txt.
# SEED_OWNER_PIN=""
# SEED_STAFF_PIN=""

# Demo mode (badge, PIN hints, no backups). Automatic on Vercel; set to 1 to try it locally.
# DEMO_MODE="1"

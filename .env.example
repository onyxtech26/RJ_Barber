# RJ Barber POS — environment (copy to .env.local; everything is optional)

# SQLite database file. Default: file:data/rj-pos.db
# DATABASE_URL="file:data/rj-pos.db"

# Initial PINs used by `npm run db:seed` (4–6 digits). If unset, random PINs are
# generated and written to data/initial-pins.txt.
# SEED_OWNER_PIN=""
# SEED_STAFF_PIN=""
